// DLogM_to_DWG.dctl
// DJI D-Log M (Osmo Action 6 / Osmo 360 II)  ->  DaVinci Wide Gamut / DaVinci Intermediate
// Version 1.3, 2026-11-05
//
// Eingang : D-Log M Codewerte, so wie Resolve sie ohne Color Management liest (0..1, Video-Range normiert).
//           Diese DCTL muss im ERSTEN Node sitzen, vor jeder anderen Korrektur.
// Ausgang : DaVinci Wide Gamut, wahlweise DaVinci Intermediate (Standard) oder linear. 18%-Grau = 0.18 linear
//           bei D-Log M Code 0.414 (Platzierung wie in der DJI-LUT). Keine Clamps.
//
// Osmo Action 6: Kurve aus Tageslicht-Belichtungsreihe (Licht ueber Kamera-Belichtungsmesser korrigiert) plus
//                Innenraum-Reihe bei konstantem Licht. Matrix aus der DJI-LUT "OA6 D-LogM to Rec.709 v11.17".
// Osmo 360 II  : Kurve aus Innenraum-Reihe bei konstantem Licht (Einzelobjektiv, gilt auch im 360-Modus).
//                Matrix: Action-6-Matrix x Angleichung 360->Action 6, gemessen an derselben Farbtafel.
// Details, Messmethode und Tests: README.md

DEFINE_UI_PARAMS(p_Cam, Kamera, DCTLUI_COMBO_BOX, 0, { CAM_A6, CAM_360 }, { Osmo Action 6, Osmo 360 II })
DEFINE_UI_PARAMS(p_Output, Ausgabe, DCTLUI_COMBO_BOX, 0, { OUT_DI, OUT_LIN }, { DaVinci Intermediate, Linear })
DEFINE_UI_PARAMS(p_Gamut, Farbraum, DCTLUI_COMBO_BOX, 0, { GAM_DWG, GAM_709 }, { DaVinci Wide Gamut, Rec709 linear Test })
DEFINE_UI_PARAMS(p_EV, Belichtung EV, DCTLUI_SLIDER_FLOAT, 0.0, -6.0, 6.0, 0.01)

#define DLOGM_N 512
#define A6_TOP_SLOPE 8.88492387f
#define A6_TOE_SLOPE 0.11155641f
#define O360_TOP_SLOPE 5.98654951f
#define O360_TOE_SLOPE 0.04912012f

