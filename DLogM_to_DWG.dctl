__DEVICE__ float decode_a6(float v)
{
    if (v <= 0.0f) return v * A6_TOE_SLOPE;
    if (v >= 1.0f) return A6_TABLE[DLOGM_N] * _exp2f((v - 1.0f) * A6_TOP_SLOPE);
    float x = v * (float)DLOGM_N;
    int i = (int)_floorf(x);
    if (i > DLOGM_N - 1) i = DLOGM_N - 1;
    float f = x - (float)i;
    return A6_TABLE[i] + (A6_TABLE[i + 1] - A6_TABLE[i]) * f;
}

__DEVICE__ float decode_360(float v)
{
    if (v <= 0.0f) return v * O360_TOE_SLOPE;
    if (v >= 1.0f) return O360_TABLE[DLOGM_N] * _exp2f((v - 1.0f) * O360_TOP_SLOPE);
    float x = v * (float)DLOGM_N;
    int i = (int)_floorf(x);
    if (i > DLOGM_N - 1) i = DLOGM_N - 1;
    float f = x - (float)i;
    return O360_TABLE[i] + (O360_TABLE[i + 1] - O360_TABLE[i]) * f;
}

__DEVICE__ float lin_to_di(float x)
{
    // DaVinci Intermediate OETF (Blackmagic Design, DaVinci Resolve 17 Wide Gamut Intermediate)
    const float DI_A = 0.0075f;
    const float DI_B = 7.0f;
    const float DI_C = 0.07329248f;
    const float DI_M = 10.44426855f;
    const float DI_LIN_CUT = 0.00262409f;
    if (x <= DI_LIN_CUT) return x * DI_M;
    return (_log2f(x + DI_A) + DI_B) * DI_C;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float r, g, b;
    if (p_Cam == CAM_360) {
        r = decode_360(p_R); g = decode_360(p_G); b = decode_360(p_B);
    } else {
        r = decode_a6(p_R); g = decode_a6(p_G); b = decode_a6(p_B);
    }

    float k = _exp2f(p_EV);
    r *= k; g *= k; b *= k;

    float R, G, B;
    if (p_Cam == CAM_360) {
        if (p_Gamut == GAM_DWG) {
            R = +0.56009267f * r +0.33568837f * g +0.10421895f * b;
            G = +0.03365971f * r +0.74271516f * g +0.22362514f * b;
            B = +0.00994754f * r +0.14646702f * g +0.84358545f * b;
        } else {
            R = +1.03567707f * r +0.03339193f * g -0.06906900f * b;
            G = -0.04769197f * r +1.00229733f * g +0.04539465f * b;
            B = -0.06440200f * r -0.06475193f * g +1.12915393f * b;
        }
    } else {
        if (p_Gamut == GAM_DWG) {
            R = +0.69009097f * r +0.23532353f * g +0.07458549f * b;
            G = +0.01577094f * r +0.81244133f * g +0.17178774f * b;
            B = +0.00998256f * r +0.09188936f * g +0.89812808f * b;
        } else {
            R = +1.29666111f * r -0.20658848f * g -0.09007263f * b;
            G = -0.09630218f * r +1.14054073f * g -0.04423855f * b;
            B = -0.07450450f * r -0.15300436f * g +1.22750886f * b;
        }
    }

    if (p_Output == OUT_DI) {
        R = lin_to_di(R); G = lin_to_di(G); B = lin_to_di(B);
    }
    return make_float3(R, G, B);
}
